# ====== Huquq backend muhit o'zgaruvchilari (namuna) ======
# Bu faylni nusxalab ".env" deb nomlang va qiymatlarni to'ldiring.
# .env fayli .gitignore'da — parollaringiz GitHubga ketmaydi.

# --- MongoDB Atlas ulanish manzili (MAJBURIY) ---
# Atlas → Connect → Drivers bo'limidan oling.
# <db_password> o'rniga haqiqiy parolni qo'ying, oxiriga baza nomini (huquq_db) qo'shing.
MONGO_URI=mongodb+srv://huquq_user:<db_password>@cluster0.xxxxx.mongodb.net/huquq_db?retryWrites=true&w=majority

# --- Gemini AI kaliti (ixtiyoriy — baza bo'lmasa AI shu kalit bilan ishlaydi) ---
# https://aistudio.google.com/app/apikey dan oling.
GEMINI_API_KEY=

# --- Server porti (ixtiyoriy, standart 5000) ---
PORT=5000
