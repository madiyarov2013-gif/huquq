    function showAddCard(tcard) {
        if (tcard < 1 || tcard > 6) {
            return;
        }

        $('#add_info').val('0').trigger('change');

        if (tcard == "1") {
            showIframeCard('/actinfo/card1/6445145');
        }
        else if (tcard == "2") {
            showIframeCard('/actinfo/card2/6445145');
        }
        else if (tcard == "3") {
            showIframeCard('/actinfo/basrev/6445145');
        }
        else if (tcard == "4") {
            showIframeCard('/actinfo/revhis/6445145');
        }
        else if (tcard == "5") {
            showIframeCard('/actinfo/correspondents/6445145');
        }
        else if (tcard == "6") {
            showIframeCard('/actinfo/respondents/6445145');
        }
    }

    function showIframeCard(_url) {
        $("#iframeShowCard").attr("src", _url);
        $('#modalShowCard').modal('show');
    }

    $('#modalShowCard').on('hidden.bs.modal', function () {
        $("#iframeShowCard").attr("src", "about:blank");  // clear after close
    });

    $(document).ready(function () {
        
    });
</script>
<script type="text/javascript">
